<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal SCORM 1.2 imsmanifest.xml for testing course launch and tracking.
  Package this directory as a .zip and upload to Moodle as a SCORM activity.
-->
<manifest identifier="moodleshield-sample-scorm"
          version="1.2"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2">

  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>

  <organizations default="sample_org">
    <organization identifier="sample_org">
      <title>MoodleShield Sample Course</title>
      <item identifier="item_1" identifierref="resource_1">
        <title>Module 1: Introduction</title>
        <adlcp:masteryscore>80</adlcp:masteryscore>
      </item>
    </organization>
  </organizations>

  <resources>
    <resource identifier="resource_1"
              type="webcontent"
              adlcp:scormtype="sco"
              href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>

</manifest>
